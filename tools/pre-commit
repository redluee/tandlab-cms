#!/bin/sh
# Geïnstalleerd door composer (Tools\HookInstaller). Blokkeert de commit als
# lint (phpcs), static analysis (phpstan) of de testsuite (phpunit) falen.

cd "$(git rev-parse --show-toplevel)" || exit 1

if [ ! -x vendor/bin/phpunit ]; then
    echo "Dev-dependencies ontbreken; run 'composer install'." >&2
    exit 1
fi

composer check
