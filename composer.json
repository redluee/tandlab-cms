{
    "name": "tandlab/cms",
    "description": "Tandlab CMS - dev tooling only, geen runtime dependencies",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^3.11",
        "phpstan/phpstan": "^2.1"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Tools\\": "tools/"
        }
    },
    "scripts": {
        "lint": "phpcs",
        "stan": "phpstan analyse --memory-limit=512M",
        "test": "phpunit",
        "check": [
            "@lint",
            "@stan",
            "@test"
        ],
        "post-install-cmd": "Tools\\HookInstaller::install",
        "post-update-cmd": "Tools\\HookInstaller::install"
    },
    "config": {
        "sort-packages": true
    }
}
